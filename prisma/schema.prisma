generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MailAccount {
  id               String   @id @default(cuid())
  organizationName String
  email            String   @unique
  provider         String
  accessToken      String?  @db.Text
  refreshToken     String?  @db.Text
  tokenExpiresAt   DateTime?
  encryptedSecret  String?  @db.Text
  imapHost         String?
  imapPort         Int?
  imapSecure       Boolean  @default(true)
  smtpHost         String?
  smtpPort         Int?
  smtpSecure       Boolean  @default(true)
  connectionStatus String   @default("CONNECTED")
  lastConnectedAt  DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}


model EmailAttachment {
  id          String   @id
  accountId   String
  filename    String
  contentType String
  size        Int
  content     Bytes
  contentId   String?
  disposition String   @default("inline")
  createdAt   DateTime @default(now())
  sentAt      DateTime?

  @@index([accountId])
}
